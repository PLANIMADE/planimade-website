# PLANIGAMES — Apache-Konfiguration (All-Inkl)

# Eigene 404-Seite
ErrorDocument 404 /404.html

# Verzeichnislisting aus
Options -Indexes

# sitemap.xml auf die dynamische sitemap.php leiten
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Kompression (schnellere Ladezeiten), falls vom Server unterstützt
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching: Bilder/Videos lange, aber Code (HTML/CSS/JS) immer frisch prüfen
# (so erscheinen Änderungen sofort, statt aus dem Browser-Cache zu kommen)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
