# PLANIGAMES — Apache-Konfiguration (All-Inkl)

# Eigene 404-Seite
ErrorDocument 404 /404.html

# Verzeichnislisting aus
Options -Indexes

# sitemap.xml auf die dynamische sitemap.php leiten + saubere URLs ohne .html
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- SICHERHEIT: interne Daten NIE ausliefern ---
  # Whitelist statt Sperrliste: In /data/ sind per HTTP ausschließlich die
  # Inhalts-JSONs erreichbar, die die Website selbst lädt. Alles andere
  # (Mail-Zugang, Passwörter, Wartelisten, Kontakte, Keys, Logs, künftige
  # Dateien) wird mit 403 abgewiesen. Steht bewusst HIER in der Root-Datei,
  # weil der data/-Ordner beim Deployment nicht hochgeladen wird.
  RewriteRule ^data/(?!(?:studio|team|games|patchnotes|legal|redirects)(?:\.en)?\.json$) - [F,L,NC]
  RewriteRule ^data/?$ - [F,L,NC]

  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # --- Schnellere Bilder: WebP-Version ausliefern, falls vorhanden ---
  # Der Admin legt beim Hochladen neben foto.jpg automatisch foto.jpg.webp an.
  # Browser, die WebP können, bekommen unter derselben Adresse die kleinere Datei;
  # fehlt sie (oder ist sie leer), kommt ganz normal das Original.
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME}.webp -s
  RewriteRule ^media/(.+)\.(jpe?g|png)$ media/$1.$2.webp [NC,T=image/webp,L]

  # --- Saubere URLs: /games statt /games.html ---
  # 1) Extensionslose Anfrage intern auf die echte .html-/.php-Datei mappen
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]

  # 2) Sichtbares ".html" aus der Adresszeile entfernen (301, Query bleibt)
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  # 3) "index" ganz entfernen -> /
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?/] [NC]
  RewriteRule ^index(\.html)?/?$ / [R=301,L]
</IfModule>

# Kompression (schnellere Ladezeiten), falls vom Server unterstützt
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Web-App-Manifest korrekt ausliefern (für „Zum Homescreen hinzufügen")
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>

# Caching: Bilder/Videos lange, aber Code (HTML/CSS/JS) immer frisch prüfen
# (so erscheinen Änderungen sofort, statt aus dem Browser-Cache zu kommen)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Service Worker immer frisch prüfen, damit Updates sofort greifen
  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  # JPG/PNG gibt es je nach Browser als Original oder WebP – Zwischenspeicher sollen das unterscheiden
  <FilesMatch "\.(jpe?g|png)(\.webp)?$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>
