# Cloud-Sync (optional). Ohne diese Werte läuft die App im lokalen Gast-Modus.
# Kopiere diese Datei zu `.env.local` und trage die Werte aus deinem
# Supabase-Projekt ein (Project Settings → API).
#
# Danach in Supabase einmalig `supabase/schema.sql` im SQL-Editor ausführen
# und unter Authentication → Providers „Email" (Magic Link) aktivieren.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
