---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Marquee from '../components/Marquee.astro';

const marqueeItems = [
  'Blender',
  'Unreal Engine 5',
  'Cinema-Grading',
  'Motion Design',
  'Produktvisualisierung',
  'Echtzeit-Rendering',
  'Videoschnitt',
  'Webentwicklung',
];
---

<Base
  title="Dominic Majewski – 3D, Motion Design & Web Development"
  description="Portfolio von Dominic Majewski: fotorealistische 3D-Renderings in Blender, Echtzeit-Szenen in Unreal Engine 5, cinematischer Schnitt und handgeschriebene Websites."
>
  <!-- ================================================================ HERO -->
  <section class="relative flex min-h-[100svh] flex-col justify-end overflow-hidden">
    <canvas data-hero-canvas class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div
      data-hero-fallback
      class="absolute inset-0 opacity-0 transition-opacity duration-1000"
      style="background: radial-gradient(120% 80% at 20% 10%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 60%), radial-gradient(90% 60% at 85% 30%, color-mix(in srgb, var(--signal) 25%, transparent), transparent 65%)"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-64"
      style="background: linear-gradient(to top, var(--bg), transparent)"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative z-10 pb-16 pt-32 sm:pb-24">
      <div
        data-availability
        class="mb-10 inline-flex items-center gap-2.5 rounded-full border border-line bg-bg/50 px-4 py-2 opacity-0 backdrop-blur transition-opacity duration-700"
      >
        <span data-availability-dot class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
        <span data-availability-label class="text-xs font-medium text-emerald-300">Verfügbarkeit wird geladen</span>
        <span class="h-3 w-px bg-line-strong"></span>
        <span data-availability-detail class="text-xs text-muted"></span>
      </div>

      <h1 class="display-xl text-ink">
        <span class="line-mask"><span data-name-first>Dominic</span></span>
        <span class="line-mask"><span class="text-outline hover:text-ink" data-name-last>Majewski</span></span>
      </h1>

      <div class="mt-10 grid gap-8 border-t border-line pt-8 md:grid-cols-[1.2fr_1fr] md:items-start">
        <p class="max-w-xl text-lg leading-relaxed text-muted sm:text-xl" data-tagline>
          Ich baue digitale Welten, die man nicht mehr wegklicken will.
        </p>

        <div class="flex flex-col gap-6 sm:flex-row sm:items-center md:justify-end">
          <p class="label-mono" data-role>3D · Motion · Code</p>
          <a
            href="/work/"
            data-magnetic="0.35"
            data-cursor="hover"
            class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-sm font-semibold text-bg"
          >
            <span data-magnetic-inner class="flex items-center gap-3">
              Arbeiten ansehen
              <span class="transition-transform duration-500 group-hover:translate-x-1">→</span>
            </span>
          </a>
        </div>
      </div>
    </div>

    <div class="container-page relative z-10 pb-8" aria-hidden="true">
      <div class="flex items-center gap-3 text-faint">
        <span class="font-mono text-[0.625rem] tracking-[0.3em]">SCROLLEN</span>
        <span class="h-px w-16 origin-left animate-pulse bg-current"></span>
      </div>
    </div>
  </section>

  <Marquee items={marqueeItems} class="mt-0" />

  <!-- =============================================================== INTRO -->
  <section class="container-page relative py-28 sm:py-36" id="intro">
    <div class="glow -left-20 top-20 h-72 w-72" style="background: var(--accent)"></div>

    <div class="relative grid gap-16 lg:grid-cols-[1fr_1.15fr] lg:gap-24">
      <div>
        <p class="label-mono" data-reveal>Kurz vorgestellt</p>
        <h2 class="display-md mt-6 text-ink line-mask">
          <span>Zwischen Viewport,<br />Schnittfenster und Editor.</span>
        </h2>

        <div class="mt-10 flex flex-wrap gap-x-10 gap-y-6" data-reveal data-reveal-delay="120">
          <div>
            <p class="text-3xl font-bold tracking-tight text-ink">8+</p>
            <p class="label-mono mt-1">Jahre Praxis</p>
          </div>
          <div>
            <p class="text-3xl font-bold tracking-tight text-ink">4</p>
            <p class="label-mono mt-1">Disziplinen</p>
          </div>
          <div>
            <p class="text-3xl font-bold tracking-tight text-ink">24 h</p>
            <p class="label-mono mt-1">Antwortzeit</p>
          </div>
        </div>
      </div>

      <div class="space-y-6 text-base leading-relaxed text-muted sm:text-lg" data-intro data-reveal data-reveal-delay="80">
        <p>
          Hi, ich bin Dominic. Seit Jahren bewege ich mich zwischen Blender-Viewport,
          Unreal-Engine-Sequencer, Schnittprogramm und Code-Editor – und genau in dieser Mischung
          entsteht meine Arbeit.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================ ARBEITEN -->
  <section class="container-page py-16 sm:py-24" id="arbeiten">
    <SectionHeading
      label="Ausgewählte Arbeiten"
      title="Projekte, die geblieben sind"
      lead="Eine Auswahl aus 3D, Bewegtbild und Web. Fahre über eine Karte für die Vorschau, klicke für die ganze Geschichte dahinter."
      action={{ href: '/work/', label: 'Alle Projekte' }}
    />

    <p data-work-status class="hidden py-20 text-center text-sm text-faint"></p>
    <div data-work-grid data-limit="5" class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-2 lg:gap-10"></div>
  </section>

  <!-- ============================================================== SKILLS -->
  <section class="container-page py-28 sm:py-36" id="leistungen">
    <SectionHeading
      label="Was ich mache"
      title="Vier Disziplinen, ein Ergebnis"
      lead="Weil alles aus einer Hand kommt, muss niemand zwischen Gewerken übersetzen – und der Look bleibt vom ersten Frame bis zur letzten Zeile Code derselbe."
    />

    <div data-skills class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"></div>
  </section>

  <!-- ============================================================ PROZESS -->
  <section class="container-page py-16 sm:py-24" id="ablauf">
    <SectionHeading label="Ablauf" title="Wie ein Projekt läuft" />
    <ol data-process class="mt-14 border-b border-line"></ol>
  </section>

  <!-- ======================================================== TESTIMONIALS -->
  <section class="container-page py-28 sm:py-36">
    <SectionHeading label="Rückmeldungen" title="Was Kund:innen sagen" />
    <div data-testimonials class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div>
  </section>

  <!-- ================================================================= CTA -->
  <section class="container-page pb-16">
    <div class="surface-card relative overflow-hidden px-8 py-20 text-center sm:px-16 sm:py-28">
      <div class="glow left-1/2 top-0 h-80 w-80 -translate-x-1/2" style="background: var(--accent)"></div>

      <div class="relative">
        <p class="label-mono" data-reveal>Nächster Schritt</p>
        <h2 class="display-lg mx-auto mt-6 max-w-3xl text-ink line-mask">
          <span>Lass uns etwas bauen.</span>
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-base text-muted" data-reveal data-reveal-delay="100">
          Ob fertiges Briefing oder erste vage Idee – schreib mir, was du vorhast. Der Rest ergibt
          sich im Gespräch.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal data-reveal-delay="160">
          <a
            href="/contact/"
            data-magnetic="0.35"
            data-cursor="hover"
            class="rounded-full bg-accent px-8 py-4 text-sm font-semibold text-white"
          >
            <span data-magnetic-inner class="block">Projekt anfragen</span>
          </a>
          <a href="#" data-mail-link data-cursor="hover" class="link-underline font-mono text-sm text-muted">…</a>
        </div>
      </div>
    </div>
  </section>
</Base>
