---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<Base
  title="Über mich – Dominic Majewski"
  description="Werdegang, Kompetenzen und Arbeitsweise von Dominic Majewski – 3D, Echtzeit und Bewegtbild. Als Lebenslauf zum Durchklicken und Ausdrucken."
>
  <div data-resume>
    <!-- ============================================================= KOPF -->
    <section class="container-page pt-[calc(var(--nav-height)+5rem)]">
      <div class="flex flex-wrap items-start justify-between gap-8">
        <div class="max-w-2xl">
          <p class="label-mono flex items-center gap-3" data-reveal>
            <span class="inline-block h-px w-8 bg-accent"></span>
            <span data-text="about.label">Lebenslauf</span>
          </p>

          <h1 class="display-lg mt-6 text-ink line-mask">
            <span data-name>Dominic Majewski</span>
          </h1>
          <p class="mt-5 text-lg text-muted" data-role>3D Artist · Motion Designer</p>

          {/* Nur im Ausdruck sichtbar – dort fehlt sonst jede Kontaktangabe. */}
          <p class="print-only mt-2 text-sm" data-print-contact></p>
        </div>


      </div>

      <dl class="mt-12 grid grid-cols-2 gap-8 border-y border-line py-8 sm:grid-cols-4" data-resume-facts></dl>
    </section>

    <!-- ============================================================ INTRO -->
    <section class="container-page mt-16">
      <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
        <div class="space-y-6 text-base leading-relaxed text-muted sm:text-lg" data-intro data-reveal>
          <p>Wird geladen …</p>
        </div>

        <aside class="space-y-8" data-reveal data-reveal-delay="100">
          {/* Porträt – erscheint nur, wenn im Dashboard ein Bild hinterlegt ist.
              In der Breite gedeckelt: Über die volle Spalte war das Bild höher
              als der Text daneben lang, und darunter klaffte bis zum Werdegang
              eine tote Fläche. */}
          <figure data-portrait class="hidden max-w-[17rem]">
            <div class="overflow-hidden rounded-2xl border border-line bg-elevated">
              <img data-portrait-image alt="" class="aspect-[4/5] w-full object-cover" loading="lazy" decoding="async" />
            </div>
            <figcaption data-portrait-caption class="mt-3 font-mono text-xs text-faint"></figcaption>
          </figure>

          <div>
            <p class="label-mono" data-text="about.aside.location">Standort</p>
            <p class="mt-2 text-sm text-ink" data-location>Deutschland · remote weltweit</p>
          </div>

          <div data-availability-block>
            <p class="label-mono" data-text="about.aside.status">Status</p>
            <div
              data-availability
              class="mt-3 inline-flex items-center gap-2.5 rounded-full border border-line px-4 py-2 opacity-0 transition-opacity duration-700"
            >
              <span data-availability-dot class="h-1.5 w-1.5 rounded-full"></span>
              <span data-availability-label class="text-xs font-medium"></span>
            </div>
            <p class="mt-2 text-sm text-muted" data-availability-detail></p>
          </div>

          <div data-languages-block>
            <p class="label-mono" data-text="about.aside.languages">Sprachen</p>
            <ul class="mt-3 space-y-2" data-languages></ul>
          </div>

          <div>
            <p class="label-mono" data-text="about.aside.contact">Erreichbar</p>
            <a href="#" data-mail-link data-cursor="hover" class="link-underline mt-2 block font-mono text-sm text-ink">…</a>
          </div>

          <div class="no-print">
            <p class="label-mono" data-text="about.aside.elsewhere">Woanders</p>
            <ul class="mt-3 space-y-2 text-sm" data-socials><li class="text-faint">…</li></ul>
          </div>
        </aside>
      </div>
    </section>

    <!-- ======================================================= WERDEGANG -->
    <section class="container-page py-24 sm:py-32" id="werdegang">
      <SectionHeading
        label="Werdegang"
        title="Stationen"
        lead="Beruflicher Weg, Ausbildung und größere Projekte – filterbar nach Art."
        keys={{ label: 'about.timeline.label', title: 'about.timeline.headline', lead: 'about.timeline.lead' }}
      />

      <div data-timeline-filters class="no-print mt-10 flex flex-wrap gap-2" role="group" aria-label="Zeitstrahl filtern"></div>

      <ol class="mt-12" data-timeline></ol>
    </section>

    <!-- ====================================================== KOMPETENZEN -->
    <section class="container-page pb-24">
      <SectionHeading
        label="Kompetenzen"
        title="Womit ich täglich arbeite"
        lead="Selbsteinschätzung – Balken sagen weniger als Projekte, aber sie ordnen ein."
        keys={{ label: 'about.expertise.label', title: 'about.expertise.headline', lead: 'about.expertise.lead' }}
      />

      <div data-expertise class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3"></div>
    </section>

    <!-- =========================================================== SKILLS -->
    <section class="container-page pb-24 no-print">
      <SectionHeading
        label="Disziplinen"
        title="Vier Disziplinen"
        lead="Weil alles aus einer Hand kommt, muss niemand zwischen Gewerken übersetzen."
        keys={{ label: 'about.skills.label', title: 'about.skills.headline' }}
      />
      <div data-skills class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"></div>
    </section>

    <!-- ============================================================== CTA -->
    <section class="container-page pb-16 no-print">
      <div class="surface-card flex flex-col items-start justify-between gap-8 p-10 sm:flex-row sm:items-center">
        <div>
          <p class="label-mono" data-text="about.cta.label">Kontakt</p>
          <p class="display-md mt-3 text-ink" data-text="about.cta.headline">Fragen zu meiner Arbeit?</p>
        </div>
        <a
          href="/contact/"
          data-magnetic="0.3"
          data-cursor="hover"
          class="shrink-0 rounded-full bg-ink px-8 py-4 text-sm font-semibold text-bg"
        >
          <span data-magnetic-inner class="block" data-text="about.cta.button">Schreib mir</span>
        </a>
      </div>
    </section>
  </div>
</Base>
