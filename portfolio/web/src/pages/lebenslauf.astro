---
import Base from '../layouts/Base.astro';

/**
 * Bewerbungs-Lebenslauf – nur für den eingeloggten Betreiber.
 *
 * Die Seite ist statisch, ihre Daten kommen aus `/api/cv`, und die Route
 * verlangt einen Login. Ohne Anmeldung bleibt hier nur ein Hinweis:
 * Anschrift, Telefon und Geburtsjahr gehen niemand anderen etwas an.
 *
 * Gestaltung: kein Behörden-Formular, sondern ein Editorial-Blatt aus
 * demselben Baukasten wie die Website – randabfallender Kopf in der
 * Akzentfarbe, großer Name, ein Laufband aus Schlagwörtern, nummerierte
 * Abschnitte und Kenntnisse als Chipwand.
 *
 * Das Blatt bringt seine eigene Palette mit und hängt nicht am Farbschema
 * der Website. Hell oder dunkel steht im Dashboard; die Schalter oben
 * ändern Foto, Projekte, Farbe und Papier für einen einzelnen Export.
 */
---

<Base title="Lebenslauf – Dominic Majewski" description="Persönlicher Lebenslauf." noindex={true} bare={true}>
  <div data-cv>
    {/* Sperrbildschirm für alle, die nicht eingeloggt sind */}
    <section data-cv-locked hidden class="container-page grid min-h-screen place-items-center py-20">
      <div class="surface-card max-w-md p-10 text-center">
        <span class="mx-auto grid h-12 w-12 place-items-center rounded-xl border border-line-strong text-base font-bold tracking-tight">
          DM
        </span>
        <h1 class="mt-6 text-lg font-semibold tracking-tight text-ink">Nur für dich</h1>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Dieser Lebenslauf enthält persönliche Angaben und ist deshalb nicht öffentlich.
          Melde dich im Dashboard an, dann erscheint er hier.
        </p>
        <a href="/admin/" class="btn mt-8 inline-block rounded-full bg-ink px-7 py-3.5 text-sm font-semibold text-bg">
          Zum Dashboard
        </a>
        <a href="/" class="link-underline mt-6 block text-xs text-faint">Zurück zur Website</a>
      </div>
    </section>

    <div data-cv-content hidden>
      {/* Werkzeugleiste – erscheint nur am Bildschirm, nie im Ausdruck */}
      <div class="no-print sticky top-0 z-30 border-b border-line bg-bg/80 backdrop-blur">
        <div class="container-page flex flex-wrap items-center gap-x-6 gap-y-3 py-4">
          <a href="/admin/#/einstellungen" class="label-mono transition-colors hover:text-ink">← Dashboard</a>

          <div class="ml-auto flex flex-wrap items-center gap-5">
            <label class="flex cursor-pointer items-center gap-2 text-xs text-muted">
              <input type="checkbox" data-cv-toggle="photo" class="accent-[var(--accent)]" checked />
              Foto
            </label>
            <label class="flex cursor-pointer items-center gap-2 text-xs text-muted">
              <input type="checkbox" data-cv-toggle="projects" class="accent-[var(--accent)]" checked />
              Projekte
            </label>
            <label class="flex cursor-pointer items-center gap-2 text-xs text-muted">
              <input type="checkbox" data-cv-toggle="color" class="accent-[var(--accent)]" checked />
              Farbe
            </label>
            {/* Nur sinnvoll, solange „Farbe" aus ist – sonst ist das Foto ohnehin bunt. */}
            <label data-cv-only-mono hidden class="flex cursor-pointer items-center gap-2 text-xs text-muted">
              <input type="checkbox" data-cv-toggle="photocolor" class="accent-[var(--accent)]" />
              Foto farbig
            </label>
            <label class="flex cursor-pointer items-center gap-2 text-xs text-muted">
              <input type="checkbox" data-cv-toggle="dark" class="accent-[var(--accent)]" />
              Dunkles Papier
            </label>

            <button
              type="button"
              data-print
              data-cursor="hover"
              class="rounded-full bg-ink px-6 py-2.5 text-sm font-semibold text-bg"
            >
              Als PDF speichern
            </button>
          </div>
        </div>
      </div>

      <!-- Die Bühne: viel Luft um das Blatt, damit es wie ein Dokument wirkt,
           das auf einer Fläche liegt – dieselbe Optik wie bei Print-Projekten. -->
      <div class="cv-stage">
        <div class="glow cv-stage-glow" aria-hidden="true"></div>

        <article class="cv-sheet" data-cv-sheet>
          <!-- =================================================== KOPF -->
          <header class="cv-head">
            <div class="cv-head-wash" aria-hidden="true"></div>
            <div class="grain cv-head-grain" aria-hidden="true"></div>

            <div class="cv-head-inner">
              <p class="cv-kicker">
                <span>Lebenslauf</span>
                <span class="cv-kicker-rule" aria-hidden="true"></span>
                <span data-cv-year>2026</span>
              </p>

              <h1 class="cv-name">
                <span class="cv-name-first" data-name-first>Dominic</span>
                <span class="cv-name-last" data-name-last>Majewski</span>
              </h1>

              <p class="cv-role" data-role>3D Artist · Motion Designer</p>
            </div>

            <figure class="cv-photo" data-cv-photo hidden>
              <img data-cv-photo-image alt="" />
            </figure>
          </header>

          <!-- Schlagwortband – dieselben Wörter wie das Laufband der Startseite -->
          <p class="cv-strip" data-cv-strip hidden></p>

          <!-- =================================================== KÖRPER -->
          <div class="cv-body">
            <aside class="cv-rail">
              <div class="cv-rail-stack">
                <section class="cv-rail-block">
                  <h2 class="cv-rail-title">Kontakt</h2>
                  <dl class="cv-contact" data-cv-details></dl>
                </section>

                <section class="cv-rail-block" data-cv-block="languages" hidden>
                  <h2 class="cv-rail-title">Sprachen</h2>
                  <dl class="cv-contact" data-cv-languages></dl>
                </section>

                <section class="cv-rail-block" data-cv-block="facts" hidden>
                  <h2 class="cv-rail-title">Eckdaten</h2>
                  <dl class="cv-facts" data-cv-facts></dl>
                </section>

                {/* Die Chipwand steht hier und nicht im Textteil: In der
                    schmalen Spalte war sonst ein Drittel der Seite tote
                    Fläche, während der Werdegang daneben überlief. */}
                <section class="cv-rail-block" data-cv-block="expertise" hidden>
                  <h2 class="cv-rail-title">Werkzeuge &amp; Kenntnisse</h2>
                  <div class="cv-chip-wall" data-cv-expertise></div>
                </section>
              </div>
            </aside>

            <div class="cv-main">
              <section class="cv-lead" data-cv-profile-block hidden>
                <p class="cv-profile" data-cv-profile></p>
              </section>

              <section class="cv-section" data-cv-block="work" hidden>
                <h2 class="cv-section-title"><i class="cv-num" aria-hidden="true"></i>Berufserfahrung</h2>
                <div data-cv-entries="work"></div>
              </section>

              <section class="cv-section" data-cv-block="education" hidden>
                <h2 class="cv-section-title"><i class="cv-num" aria-hidden="true"></i>Ausbildung</h2>
                <div data-cv-entries="education"></div>
              </section>

              <section class="cv-section" data-cv-block="project" hidden>
                <h2 class="cv-section-title"><i class="cv-num" aria-hidden="true"></i>Ausgewählte Projekte</h2>
                <div data-cv-entries="project"></div>
              </section>
            </div>
          </div>

          <!-- =================================================== FUSS -->
          <footer class="cv-foot">
            <span class="cv-foot-mark" aria-hidden="true">DM</span>
            <span class="cv-foot-text" data-cv-footer hidden></span>
            <span class="cv-foot-link" data-cv-site></span>
          </footer>
        </article>
      </div>
    </div>
  </div>
</Base>
