---
interface Props {
  items: string[];
  duration?: number;
  separator?: string;
  class?: string;
}

const { items, duration = 34, separator = '✦', class: className = '' } = Astro.props;
// Zweimal ausgeben – die Animation läuft exakt bis -50 % und springt unsichtbar zurück.
const doubled = [...items, ...items];
---

<div
  class:list={['marquee overflow-hidden border-y border-line py-5', className]}
  style={`--marquee-duration: ${duration}s`}
  aria-hidden="true"
>
  <div class="marquee-track" data-marquee-track>
    {
      doubled.map((item) => (
        <span class="flex shrink-0 items-center gap-8 px-8">
          <span class="text-sm font-medium tracking-tight text-muted whitespace-nowrap">{item}</span>
          <span class="text-accent/60">{separator}</span>
        </span>
      ))
    }
  </div>
</div>
