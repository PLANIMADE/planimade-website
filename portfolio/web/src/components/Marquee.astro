---
interface Props {
  items: string[];
  duration?: number;
  separator?: string;
  class?: string;
}

const { items, duration = 34, separator = '✦', class: className = '' } = Astro.props;
// Zweimal ausgeben – die Animation läuft exakt bis -50 % und springt unsichtbar zurück.
const doubled = [...items, ...items];
---

<div
  class:list={['marquee overflow-hidden border-y border-line py-5', className]}
  style={`--marquee-duration: ${duration}s`}
  aria-hidden="true"
>
  <div class="marquee-track" data-marquee-track>
    {
      /* Der Abstand sitzt am Wort, nicht am Paar: So steht zwischen zwei
         Wörtern immer dieselbe Strecke, und das Trennzeichen genau in deren
         Mitte. Lag der Abstand am Paar, klebte das Zeichen am linken Wort. */
      doubled.map((item) => (
        <span class="flex shrink-0 items-center">
          <span class="whitespace-nowrap px-8 text-sm font-medium tracking-tight text-muted">{item}</span>
          <span class="text-accent/60">{separator}</span>
        </span>
      ))
    }
  </div>
</div>
