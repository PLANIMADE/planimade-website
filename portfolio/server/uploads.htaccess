# Hochgeladene Dateien dürfen niemals als Programm ausgeführt werden.
# Selbst wenn es jemand schaffen würde, eine .php-Datei hier abzulegen,
# liefert der Server sie nur als Text aus.

<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh|htaccess)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
AddType text/plain .php .phtml
