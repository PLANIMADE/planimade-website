# =============================================================================
# Konfiguration für den Webspace-Hauptordner (all-inkl / Apache)
# Wird beim Build automatisch als `.htaccess` in den Deploy-Ordner kopiert.
# =============================================================================

Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- HTTPS erzwingen -----------------------------------------------------
    # Wichtig: Das SSL-Zertifikat muss im KAS aktiviert sein, sonst zeigt der
    # Browser nach der Weiterleitung eine Zertifikatswarnung.
    #
    # Die Übergangsdomain (…kasserver.com) ist ausgenommen. Über sie lässt
    # sich die Seite schon ansehen, solange die eigene Domain noch nicht
    # aufgelöst wird oder das Zertifikat fehlt – ohne diese Ausnahme liefe
    # man in eine Weiterleitung auf eine Adresse, die es noch nicht gibt.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !\.kasserver\.com$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # --- Case-Studies --------------------------------------------------------
    # /work/mein-projekt wird von PHP ausgeliefert: gleiche Optik wie der
    # statische Build, aber mit aktuellen Inhalten und Meta-Tags für Google
    # und Link-Vorschauen. /work/detail/ ist die Hülle und bleibt außen vor.
    RewriteCond %{REQUEST_URI} !^/work/detail
    RewriteRule ^work/([a-zA-Z0-9-]+)/?$ api/index.php?_page=work/$1 [QSA,L]

    # --- Dashboard ------------------------------------------------------------
    # Adressen sind auf dem Server gross-/kleinschreibungsabhaengig: /Admin
    # liefe sonst in einen 404. Die Bedingung nimmt die richtige Schreibweise
    # aus, sonst leitete die Regel auf sich selbst weiter.
    RewriteCond %{REQUEST_URI} !^/admin/?$
    RewriteRule ^admin/?$ /admin/ [R=301,L,NC]

    # --- Sitemap -------------------------------------------------------------
    RewriteRule ^sitemap\.xml$ api/index.php?_page=sitemap [L]
</IfModule>

ErrorDocument 404 /404.html

# --- Sicherheits-Header ------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

    # Dateien mit Hash im Namen ändern sich nie – ein Jahr Cache ist sicher.
    <FilesMatch "\.(js|css|woff2|jpg|jpeg|png|webp|avif|svg|mp4|webm|glb)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML muss frisch bleiben, sonst sehen Besucher alte Inhalte.
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Kompression -------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- MIME-Typen, die Apache nicht von Haus aus kennt --------------------------
<IfModule mod_mime.c>
    AddType model/gltf-binary .glb
    AddType model/gltf+json .gltf
    AddType image/avif .avif
    AddType font/woff2 .woff2
</IfModule>

# --- Nichts Privates ausliefern ----------------------------------------------
<FilesMatch "(^\.|\.(sqlite|sqlite-wal|sqlite-shm|log|key|md|yml|json5)$)">
    Require all denied
</FilesMatch>

# package.json & Co. haben auf dem Server nichts verloren
<FilesMatch "^(package(-lock)?\.json|tsconfig\.json|astro\.config\.mjs|vite\.config\.ts)$">
    Require all denied
</FilesMatch>
